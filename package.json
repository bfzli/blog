    "www:format": "prettier -w 'src/**/*.{astro,css,html,json,md,mdx,js,jsx,ts,tsx}'",
    "www:lint": "eslint --fix 'src/**/*.{astro,js,jsx,ts,tsx}'",
    "www:generate-thumbnails": "node scripts/generate-thumbnails.js"
  },
  "devDependencies": {
    "@astrojs/check": "^0.5.6",
