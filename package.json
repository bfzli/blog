{
  "name": "bfzli",
  "version": "1.0.0",
  "description": "A place where I share my thoughts and learnings.",
  "author": "Benjamin Fazli <me@bfzli.com> (https://bfzli.com)",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/bfzli/blog"
  },
  "scripts": {
    "web:dev": "astro dev --port 9999",
    "web:build": "npm run web:check && npm run web:lint && astro build",
    "web:preview": "astro build; astro preview --port 8888",
    "web:check": "astro check",
    "web:format": "prettier -w 'src/**/*.{astro,css,html,json,md,mdx,js,jsx,ts,tsx}'",
    "web:lint": "eslint --fix '{src,scripts}/**/*.{astro,js,jsx,ts,tsx}'",
    "prepare": "husky",
    "posts:plan": "tsx scripts/plan-posts.ts",
    "posts:write": "tsx scripts/write-post.ts",
    "posts:coverage": "tsx scripts/plan-posts.ts --coverage"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/solid-js": "^5.1.3",
    "@astrojs/tailwind": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "astro": "^5.18.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^0.31.4",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-solid": "^0.13.1",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "rehype-prism-plus": "^2.0.0",
    "sharp": "^0.33.4",
    "solid-js": "^1.8.15",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5.4.2",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.4",
    "@phosphor-icons/core": "^2.1.1",
    "openai": "^7.3.0",
    "satori": "^0.26.0"
  }
}
