---
import { Page } from '@/layouts'
import { staticPages } from '@/data/pages'
import { Icon } from 'solid-heroicons'
import { faceFrown, arrowLeft } from 'solid-heroicons/outline'

const meta = staticPages['404']
---

<Page
    title={meta.title}
    description={meta.description}
    keywords={meta.keywords}
    image={`/og/${meta.slug}.webp`}
    type='website'
>
    <div class='flex flex-col items-center pt-44 text-center'>
        <Icon
            path={faceFrown}
            class='h-16 w-16 text-default'
            aria-hidden='true'
        />

        <h1 class='mt-6 text-3xl font-bold'>Page Not Found</h1>

        <p class='mt-3 text-soft'>
            The page you're looking for doesn't exist<br />
            or has been moved.
        </p>

        <a
            href='/'
            class='mt-8 inline-flex items-center gap-2 text-sm font-medium text-primary transition-hover hover:text-primary-hover'
        >
            <Icon path={arrowLeft} class='h-4 w-4' aria-hidden='true' />
            <span>Back to Home</span>
        </a>
    </div>
</Page>