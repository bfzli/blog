---
import { Home } from '@/layouts'
import { ProductList } from '@/components'
import { productGroups } from '@/data/products'
import { staticPages } from '@/data/pages'

const withRef = (url: string) =>
    `${url}${url.includes('?') ? '&' : '?'}ref=bfzli.com`

const groups = productGroups.map((group) => ({
    title: group.title,
    items: group.items.map((product) => ({
        ...product,
        href: product.url && withRef(product.url),
        external: true
    }))
}))
const meta = staticPages.products
---

<Home
    title={meta.title}
    description={meta.description}
    keywords={meta.keywords}
    image={`/og/${meta.slug}.png`}
    type='website'
>
    {
        groups.map((group, index) => (
            <ProductList
                title={group.title}
                items={group.items}
                class={index === 0 ? 'mt-8' : 'mt-10'}
            />
        ))
    }
</Home>