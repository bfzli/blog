---
import { Home } from '@/layouts'
import { ProductList } from '@/components'
import { ventures, vibeCoding } from '@/data/products'
import { staticPages } from '@/data/pages'

const productItems = [...ventures, ...vibeCoding].map((product) => ({
    ...product,
    href: product.url,
    external: true
}))
const meta = staticPages.products
---

<Home
    title={meta.title}
    description={meta.description}
    keywords={meta.keywords}
    image={`/og/${meta.slug}.png`}
    type='website'
>
    <ProductList items={productItems} />
</Home>