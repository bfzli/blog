---
import { Image } from 'astro:assets'
import Home from '@/layouts/home.astro'
import { experience, technical } from '@/data/resume'
import { getExperienceImage } from '@/utils/images'
---

<Home
    title='Resume - Benjamin Fazli'
    description='Resume of Benjamin Fazli - Software Engineer'
    keywords='resume, cv, curriculum vitae, benjamin fazli, software engineer'
    image='/images/generals/cover.webp'
    type='website'
>
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-12">
        <section>
            <h3 class="font-bold text-default mb-3">Experience</h3>
            
            <div class="space-y-8">
                {experience.map((job) => (
                    <div class="flex gap-4">
                        <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-elevate flex items-center justify-center overflow-hidden">
                            <Image
                                src={getExperienceImage(job.company)}
                                alt={job.company}
                                width={40}
                                height={40}
                                class="w-full h-full object-cover"
                            />
                        </div>
                        
                        <div class="flex-1">
                            <h3 class="font-bold text-default">
                                {job.title} at {job.company}
                            </h3>
                            <p class="text-sm text-comment mt-0.5">{job.date}</p>
                            
                            <ul class="mt-3 space-y-2">
                                {job.bullets.map((bullet) => (
                                    <li class="flex gap-2 text-sm text-default opacity-80">
                                        <span class="text-comment mt-1.5">•</span>
                                        <span>{bullet}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <aside class="space-y-8">
            <div>
                <div class="space-y-6">
                    <div>
                        <h3 class="font-bold text-default mb-3">Languages</h3>
                        <ul class="space-y-2">
                            {technical.languages.map((skill) => (
                                <li class="flex items-center gap-2 text-sm text-default opacity-80">
                                    <img
                                        src={`https://cdn.simpleicons.org/${skill.icon}`}
                                        alt={skill.name}
                                        width={16}
                                        height={16}
                                        loading="lazy"
                                        decoding="async"
                                        class="w-4 h-4 rounded-xl"
                                    />
                                    {skill.name}
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div>
                        <h3 class="font-bold text-default mb-3">Tools & Databases</h3>
                        <ul class="space-y-2">
                            {technical.tools.map((skill) => (
                                <li class="flex items-center gap-2 text-sm text-default opacity-80">
                                    <img
                                        src={`https://cdn.simpleicons.org/${skill.icon}`}
                                        alt={skill.name}
                                        width={16}
                                        height={16}
                                        loading="lazy"
                                        decoding="async"
                                        class="w-4 h-4 rounded-xl"
                                    />
                                    {skill.name}
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div>
                        <h3 class="font-bold text-default mb-3">DevOps & Cloud</h3>
                        <ul class="space-y-2">
                            {technical.devops.map((skill) => (
                                <li class="flex items-center gap-2 text-sm text-default opacity-80">
                                    <img
                                        src={`https://cdn.simpleicons.org/${skill.icon}`}
                                        alt={skill.name}
                                        width={16}
                                        height={16}
                                        loading="lazy"
                                        decoding="async"
                                        class="w-4 h-4 rounded-xl"
                                    />
                                    {skill.name}
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div>
                        <h3 class="font-bold text-default mb-3">Others</h3>
                        <ul class="space-y-2">
                            {technical.others.map((skill) => (
                                <li class="flex items-center gap-2 text-sm text-default opacity-80">
                                    <img
                                        src={`https://cdn.simpleicons.org/${skill.icon}`}
                                        alt={skill.name}
                                        width={16}
                                        height={16}
                                        loading="lazy"
                                        decoding="async"
                                        class="w-4 h-4 rounded-xl"
                                    />
                                    {skill.name}
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</Home>

