---
import { Link } from '@/components'

interface Props {
    href: string
    label?: string
    icon?: string
    class?: string
}

const {
    href,
    label = 'Visit Site',
    icon,
    class: className = 'inline-flex items-center gap-2 px-3 py-1.5 bg-post hover:bg-post-hover rounded-lg text-sm font-medium transition-colors duration-200',
} = Astro.props
---

<Link href={href} class={className}>
    {icon ? (
        <img
            src={icon}
            alt=''
            width={14}
            height={14}
            loading='lazy'
            decoding='async'
            class='w-3.5 h-3.5'
        />
    ) : (
        <svg class='w-3.5 h-3.5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6' />
            <polyline points='15 3 21 3 21 9' />
            <line x1='10' y1='14' x2='21' y2='3' />
        </svg>
    )}
    {label}
</Link>
