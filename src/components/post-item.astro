---
import { Link, ListItem } from '@/components'

interface Props {
    slug: string
    title: string
    description: string
}

const { slug, title, description } = Astro.props
---

<ListItem
    class='transition-hover group -mx-3 mt-2 flex flex-col rounded-xl first:mt-0 hover:bg-post-hover'
>
    <Link href={`/${slug}`} class='px-3 py-3'>
        <h3 class='text-[19px] font-bold text-default'>
            {title}
        </h3>

        <p class='mt-1.5 text-[14px] text-soft'>
            {description}
        </p>
    </Link>
</ListItem>