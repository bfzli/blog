---
import { Link, ListItem } from '@/components'

interface Props {
    slug: string
    title: string
    description: string
}

const { slug, title, description } = Astro.props
---

<ListItem
    class='transition-hover group mt-2 flex flex-col rounded-xl bg-post first:mt-4 hover:bg-post-hover'
>
    <Link href={`/${slug}`} class='p-4'>
        <h3 class='text-[19px] font-bold text-muted'>
            {title}
        </h3>

        <p class='mt-1.5 text-[14px] text-soft'>
            {description}
        </p>
    </Link>
</ListItem>