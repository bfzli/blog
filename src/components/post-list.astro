---
import type { Post } from '@/types'
import { List, PostItem } from '@/components'

interface Props {
    title: string
    items: Post[]
}

const { title, items } = Astro.props
---

<section data-reveal>
    <h2 class='mt-12 text-2xl font-bold'>{title}</h2>

    <List class='mt-1' data-reveal-group>
        {
            items.map((post) => (
                <PostItem
                    slug={post.slug}
                    title={post.data.title}
                    description={post.data.description}
                />
            ))
        }
    </List>
</section>