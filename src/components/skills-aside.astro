---
import type { Skill } from '@/types'
import { SkillGroup } from '@/components'
import { skillGroups } from '@/data/resume'

interface Props {
    languages: Skill[]
    tools: Skill[]
    devops: Skill[]
    others: Skill[]
}

const technical = Astro.props
---

<aside class='space-y-8' data-reveal>
    <div class='space-y-6' data-reveal-group>
        {
            skillGroups.map((group) => (
                <SkillGroup title={group.title} items={technical[group.key]} />
            ))
        }
    </div>
</aside>