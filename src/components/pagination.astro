---
import { Icon } from '@/components'
import { pagePath } from '@/utils/posts'

interface Props {
    page: number
    total: number
    class?: string
}

const { page, total, class: className = 'mt-10' } = Astro.props

const link =
    'transition-hover inline-flex items-center gap-2 text-sm font-medium text-soft hover:text-default'
---

{
    total > 1 && (
        <nav
            class:list={['flex items-center justify-between px-3', className]}
            aria-label='Pagination'
            data-reveal
        >
            {page > 1 ? (
                <a href={pagePath(page - 1)} rel='prev' class={link}>
                    <Icon name='arrowLeft' class='h-4 w-4' />
                    <span>Newer</span>
                </a>
            ) : (
                <span />
            )}

            {page < total ? (
                <a href={pagePath(page + 1)} rel='next' class={link}>
                    <span>Older</span>
                    <Icon name='arrowLeft' class='h-4 w-4 rotate-180' />
                </a>
            ) : (
                <span />
            )}
        </nav>
    )
}