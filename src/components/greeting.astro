---
import { constants } from '@/config'

const { greeting } = constants
---

<style>
    .greeting {
        position: relative;
        display: inline-block;
        height: 1.2em;
        overflow: hidden;
        line-height: 1.2em;
        vertical-align: bottom;
        perspective: 260px;
        transition: width 520ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .greeting-word {
        position: absolute;
        left: 0;
        top: 0;
        white-space: nowrap;
        opacity: 0;
        transform-origin: center center;
        transform: translateY(70%) rotateX(-88deg);
        transition:
            transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
            opacity 320ms ease;
    }

    .greeting-word.is-active {
        position: relative;
        opacity: 1;
        transform: translateY(0) rotateX(0deg);
    }

    .greeting.is-ready .greeting-word.is-active {
        position: absolute;
    }

    .greeting-word.is-leaving {
        opacity: 0;
        transform: translateY(-70%) rotateX(88deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .greeting,
        .greeting-word {
            transition: none;
        }
    }
</style>

<script is:inline>
    document.addEventListener('astro:page-load', function () {
        var root = document.querySelector('[data-greeting]')
        if (!root || root.dataset.bound) return
        root.dataset.bound = '1'

        var words = root.querySelectorAll('.greeting-word')
        if (words.length < 2) return

        var interval = Number(root.dataset.interval)
        var current = Number(root.dataset.index) || 0

        var start = function () {
            root.style.width = words[current].offsetWidth + 'px'
            root.classList.add('is-ready')

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                return
            }

            var timer = setInterval(function () {
                if (!root.isConnected) return clearInterval(timer)

                var next = (current + 1) % words.length

                words[current].classList.remove('is-active')
                words[current].classList.add('is-leaving')

                words[next].classList.remove('is-leaving')
                words[next].classList.add('is-active')

                root.style.width = words[next].offsetWidth + 'px'
                current = next
                root.dataset.index = String(current)

                try {
                    sessionStorage.setItem('greeting', String(current))
                } catch (error) {
                    return
                }
            }, interval)
        }

        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(start)
        } else {
            start()
        }
    })
</script><span class='sr-only'>{greeting.words[0].text}</span><span
    class='greeting'
    aria-hidden='true'
    transition:persist='greeting'
    data-greeting
    data-interval={greeting.interval}>{
        greeting.words.map((word, index) => (
            <span
                class:list={['greeting-word', { 'is-active': index === 0 }]}
                lang={word.lang}
                dir={word.dir}
            >{word.text}</span>
        ))
    }</span><script is:inline>
    ;(function () {
        var root = document.currentScript.previousElementSibling
        var words = root.querySelectorAll('.greeting-word')
        var index = 0

        try {
            index = Number(sessionStorage.getItem('greeting')) || 0
        } catch (error) {
            index = 0
        }

        if (!words[index] || index === 0) return

        words[0].classList.remove('is-active')
        words[index].classList.add('is-active')
        root.dataset.index = String(index)
    })()
    </script>