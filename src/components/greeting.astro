---
import { constants } from '@/config'

const { greeting } = constants
---

<style>
    .greeting {
        position: relative;
        display: inline-block;
        height: 1.2em;
        overflow: hidden;
        line-height: 1.2em;
        vertical-align: bottom;
        perspective: 260px;
        transition: width 520ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .greeting-word {
        position: absolute;
        left: 0;
        top: 0;
        white-space: nowrap;
        opacity: 0;
        transform-origin: center center;
        transform: translateY(70%) rotateX(-88deg);
        transition:
            transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
            opacity 320ms ease;
    }

    .greeting-word.is-active {
        position: relative;
        opacity: 1;
        transform: translateY(0) rotateX(0deg);
    }

    .greeting.is-ready .greeting-word.is-active {
        position: absolute;
    }

    .greeting-word.is-leaving {
        opacity: 0;
        transform: translateY(-70%) rotateX(88deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .greeting,
        .greeting-word {
            transition: none;
        }
    }
</style>

<span class='sr-only'>{greeting.words[0].text}</span><span
    class='greeting'
    aria-hidden='true'
    transition:persist='greeting'
    data-greeting
    data-interval={greeting.interval}>{
        greeting.words.map((word, index) => (
            <span
                class:list={['greeting-word', { 'is-active': index === 0 }]}
                lang={word.lang}
                dir={word.dir}
            >{word.text}</span>
        ))
    }</span>