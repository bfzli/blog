---
import { isoDate } from '@/utils/date'
import { constants } from '@/config'

interface Props {
    slug: string
    title: string
    description: string
    date: string
    tags: string[]
}

const { slug, title, description, date, tags } = Astro.props
---

<script
    type='application/ld+json'
    set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: `${constants.site}/og/${slug}.png`,
        datePublished: isoDate(date),
        author: { '@id': `${constants.site}/#person` },
        publisher: { '@id': `${constants.site}/#person` },
        isPartOf: { '@id': `${constants.site}/#website` },
        mainEntityOfPage: {
            '@type': 'WebPage',
            '@id': `${constants.site}/${slug}`
        },
        keywords: tags.join(', ')
    })}
/>