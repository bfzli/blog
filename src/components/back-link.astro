---
interface Props {
    href: string
    label?: string
}

const { href, label = 'Go back' } = Astro.props
---

<div class='mb-6'>
    <a href={href} class='flex rounded-sm text-sm font-medium text-default hover:text-muted transition-colors'>
        <span class='mr-2'>←</span>
        <span>{label}</span>
    </a>
</div>
