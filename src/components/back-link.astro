---
import { Icon } from '@/components'

interface Props {
    href: string
    label?: string
}

const { href, label = 'Go back' } = Astro.props
---

<div class='mb-6'>
    <a
        href={href}
        class='inline-flex items-center gap-2 rounded-sm text-sm font-medium text-default transition-hover hover:text-muted'
    >
        <Icon name='arrowLeft' class='h-4 w-4' />
        <span>{label}</span>
    </a>
</div>