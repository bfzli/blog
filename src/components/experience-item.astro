---
import type { Experience } from '@/types'

const job = Astro.props as Experience

const initials = job.company
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase()
---

<div class='flex gap-4'>
    <div
        class='flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl text-xs font-semibold text-comment'
    >
        {
            job.logo ? (
                <img
                    src={job.logo.src}
                    alt={job.company}
                    width={40}
                    height={40}
                    loading='lazy'
                    decoding='async'
                    class='h-full w-full object-cover'
                />
            ) : (
                <span>{initials}</span>
            )
        }
    </div>

    <div class='flex-1'>
        <h3 class='font-bold text-default'>
            {job.title} at {job.company}
        </h3>
        <p class='mt-0.5 text-sm text-comment'>{job.date}</p>

        <ul class='mt-3 space-y-2'>
            {
                job.bullets.map((bullet) => (
                    <li class='flex gap-2 text-[15px] text-muted'>
                        <span
                            class='mt-[8px] h-1 w-1 flex-shrink-0 rounded-full bg-comment'
                            aria-hidden='true'
                        />
                        <span>{bullet}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</div>