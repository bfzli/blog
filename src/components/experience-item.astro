---
import type { Experience } from '@/types'
import { Image } from 'astro:assets'

const job = Astro.props as Experience

const initials = job.company
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase()
---

<div class='flex gap-4'>
    <div class='flex-shrink-0 w-10 h-10 rounded-xl bg-elevate flex items-center justify-center overflow-hidden text-xs font-semibold text-comment'>
        {job.logo ? (
            <Image
                src={job.logo}
                alt={job.company}
                width={40}
                height={40}
                class='w-full h-full object-cover'
            />
        ) : (
            <span>{initials}</span>
        )}
    </div>

    <div class='flex-1'>
        <h3 class='font-bold text-default'>
            {job.title} at {job.company}
        </h3>
        <p class='text-sm text-comment mt-0.5'>{job.date}</p>

        <ul class='mt-3 space-y-2'>
            {job.bullets.map((bullet) => (
                <li class='flex gap-2 text-[15px] text-muted'>
                    <span class='flex-shrink-0 mt-[8px] w-1 h-1 rounded-full bg-comment' aria-hidden='true' />
                    <span>{bullet}</span>
                </li>
            ))}
        </ul>
    </div>
</div>
