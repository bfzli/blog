---
import type { Product } from '@/types'
import { IconTile } from '@/components'

const { name, description, icon, href, external = false } = Astro.props as Product
---

<li class='py-1'>
    <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        class='group block rounded-lg p-2 -mx-2 hover:bg-post transition-colors duration-200'
    >
        <div class='flex items-start gap-4'>
            <IconTile src={icon} alt={name} />
            <div class='flex-1 min-w-0'>
                <h3 class='text-lg font-semibold text-default'>{name}</h3>
                <p class='-mt-1 text-sm text-soft leading-relaxed'>{description}</p>
            </div>
        </div>
    </a>
</li>
