---
interface Props {
    href: string
    external?: boolean
}

const { href, external = true } = Astro.props
---

<a
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    class='border-b border-elevate outline-none text-primary hover:text-primary-hover transition-colors'
>
    <slot />
</a>
