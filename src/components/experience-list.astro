---
import type { Experience } from '@/types'
import { ExperienceItem } from '@/components'

interface Props {
    items: Experience[]
}

const { items } = Astro.props
---

<section>
    <h3 class='font-bold text-default mb-3'>Experience</h3>

    <div class='space-y-8'>
        {items.map((job) => <ExperienceItem {...job} />)}
    </div>
</section>
