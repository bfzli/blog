<script is:inline>
    ;(function () {
        var KEY = 'theme'
        var MODES = ['system', 'light', 'dark']
        var root = document.documentElement
        var query = window.matchMedia('(prefers-color-scheme: dark)')

        function readMode() {
            try {
                var stored = localStorage.getItem(KEY)
                return MODES.indexOf(stored) === -1 ? 'system' : stored
            } catch (error) {
                return 'system'
            }
        }

        function applyTheme() {
            var mode = readMode()
            var theme =
                mode === 'system' ? (query.matches ? 'dark' : 'light') : mode

            root.setAttribute('data-theme-mode', mode)
            root.setAttribute('color-scheme', theme)

            var color = theme === 'dark' ? '#0a0a0b' : '#fcfcfc'
            document
                .querySelectorAll('meta[name="theme-color"]')
                .forEach(function (meta) {
                    meta.setAttribute('content', color)
                })

            var button = document.querySelector('#toggle-theme')
            if (button) button.setAttribute('aria-label', 'Theme: ' + mode)
        }

        applyTheme()

        query.addEventListener('change', applyTheme)

        document.addEventListener('astro:after-swap', applyTheme)
        document.addEventListener('astro:page-load', applyTheme)
        document.addEventListener('themechange', applyTheme)
    })()
</script>