---
import { Image } from 'astro:assets'

interface Props {
    src: ImageMetadata
    alt: string
    size?: number
}

const { src, alt, size = 48 } = Astro.props
---

<div
    class='flex items-center justify-center rounded-2xl bg-elevate'
    style={`width:${size}px;height:${size}px`}
>
    <Image
        src={src}
        alt={alt}
        width={size}
        height={size}
        class='h-full w-full rounded-2xl object-contain'
    />
</div>