---
import Page from '@/layouts/page.astro'

import { Navigation, DynamicAge } from '@/components'
import { constants } from '@/config'
import ThemeToggle from '@/components/theme-toggle.astro'

import type { Props } from '@/types'

const props = Astro.props as Props
---

<Page {...props}>
    <header class='flex justify-end -mt-12 sm:-mt-18 mb-6'>
        <ThemeToggle />
    </header>

    <div transition:persist="home-header">
        <img 
            src='/images/generals/avatar.webp' 
            alt='Benjamin' 
            ondragstart="return false"
            class='w-24 mb-6 h-24 rounded-full select-none' 
        />

        <h1 class='mt-4 mb-2 text-4xl font-bold'>
            I'm Benjamin 👋
        </h1>

        <section class='mb-4 mt-2 space-y-2'>
            <h2 class='text-md font-normal leading-loose sm:leading-loose'>
                A software engineer based in <a href="https://www.google.com/search?q=Skopje,+North+Macedonia" target="_blank" rel="noopener noreferrer" class="border-b border-elevate outline-none text-primary hover:opacity-80 transition-opacity">Skopje, North Macedonia</a>, <DynamicAge birthDate={constants.profile.birthDate.toISOString()} client:load /> years old, building amazing products. Currently building <a href="https://envless.cloud" target="_blank" rel="noopener noreferrer" class="border-b border-elevate outline-none text-primary hover:opacity-80 transition-opacity">@envless</a>, <a href="https://clawhost.cloud" target="_blank" rel="noopener noreferrer" class="border-b border-elevate outline-none text-primary hover:opacity-80 transition-opacity">@clawhost</a>, and <a href="https://ip2geo.dev" target="_blank" rel="noopener noreferrer" class="border-b border-elevate outline-none text-primary hover:opacity-80 transition-opacity">@ip2geo</a>.
            </h2>
        </section>

        <div class="h-[1px] bg-elevate w-full mt-8" />

        <div class="mt-6">
            <Navigation currentPath={Astro.url.pathname} client:load />
        </div>
    </div>

    <slot />
</Page>

