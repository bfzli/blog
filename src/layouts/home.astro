---
import type { Props } from '@/types'
import { Page } from '@/layouts'
import { HomeHero, ThemeToggle } from '@/components'

const props = Astro.props as Props
---

<Page {...props}>
    <header class='flex justify-end -mt-12 sm:-mt-18 mb-6'>
        <ThemeToggle />
    </header>

    <HomeHero />

    <slot />
</Page>
